rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function donoMedico(pid) { return logado() && get(/databases/$(database)/documents/pacientes/$(pid)).data.medicoId == request.auth.uid; }
    function ehPaciente(pid) { return logado() && get(/databases/$(database)/documents/pacientes/$(pid)).data.email == request.auth.token.email; }

    match /medicos/{uid} { allow read, write: if logado() && request.auth.uid == uid; }

    match /pacientes/{pid} {
      allow create: if logado() && request.resource.data.medicoId == request.auth.uid;
      allow read: if logado() && (resource.data.medicoId == request.auth.uid || resource.data.email == request.auth.token.email);
      allow update, delete: if logado() && resource.data.medicoId == request.auth.uid;

      match /avaliacoes/{id} { allow read: if donoMedico(pid) || ehPaciente(pid); allow write: if donoMedico(pid); }
      match /metas/{id}      { allow read: if donoMedico(pid) || ehPaciente(pid); allow write: if donoMedico(pid); }
    }
  }
}
